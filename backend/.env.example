# copy to .env for local development — never commit the real .env

PORT=3000

# JWT
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=28800

# MySQL — same instance/schema the ingestion-service connects to
# (docker-compose service name "mysql" once that's wired up; localhost for
# bare-metal local dev against the throwaway container used during scaffolding)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=ubiqedge_water_billing

# HMAC secret for the mock payment webhook (/payments/v1/webhook/:provider)
PAYMENT_WEBHOOK_SECRET=change-me-in-every-environment
