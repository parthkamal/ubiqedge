# copy to .env — never commit the real .env

INGEST_BASE_URL=http://localhost:3001

# from seed.py's output — org's ingestion API key (shown once at seed time)
ORG_CODE=ORG01
API_KEY=

# how often to send a reading, ms (default 300000 = 5 min, per FR cadence)
INTERVAL_MS=300000

# read-only: used once at startup to discover candidate METER devices for
# ORG_CODE (same DB the backend/ingestion-service connect to)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=ubiqedge_water_billing
